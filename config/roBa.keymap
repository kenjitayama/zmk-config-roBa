#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 9 Q                  &kp W         &kp E      &kp R         &kp T                                                      &kp Y                         &kp U    &kp I        &kp O                         &kp P
&mt LEFT_CONTROL A       &lt 2 S       &kp D      &lt 6 F       &mt LEFT_CONTROL G           &none          &kp BACKSPACE  &kp H                         &lt 6 J  &lt 4 K      &lt 5 L                       &lt 3 SEMICOLON
&mt LEFT_SHIFT Z         &kp X         &kp C      &kp V         &kp B                        &kp TAB        &lt 1 ENTER    &kp N                         &kp M    &lt 7 COMMA  &mt LS(LG(LEFT_CONTROL)) DOT  &mt RIGHT_SHIFT SLASH
&lt_to_layer_0 0 ESCAPE  &kp CAPSLOCK  &kp MINUS  &kp LEFT_ALT  &mt LEFT_COMMAND LANGUAGE_2  &kp SPACE      &kp SPACE      &mt RIGHT_COMMAND LANGUAGE_1                                                      &kp LC(LG(LEFT_ALT))
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans                       &trans                       &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans  &trans  &trans  &trans                       &trans  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans                       &trans  &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&trans  &trans  &trans  &lt_to_layer_0 7 LEFT_SHIFT  &to 8   &trans      &trans   &trans                          &kp F12
            >;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                             &kp ASTRK  &kp N7  &kp N8  &kp N9  &kp PLUS
&trans  &trans  &trans  &trans  &trans  &trans      &trans         &kp SLASH  &kp N4  &kp N5  &kp N6  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans      &kp BACKSPACE  &kp DOT    &kp N1  &kp N2  &kp N3  &kp N0
&trans  &trans  &trans  &trans  &trans  &trans      &trans         &kp ENTER                          &trans
            >;
        };

        ARROW {
            bindings = <
&trans     &trans  &trans  &trans  &trans                      &trans  &trans          &kp UP_ARROW    &trans           &trans
&kp LC(A)  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans     &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans          &trans          &trans           &trans
&trans     &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SYMBOL {
            bindings = <
&kp EXCL           &kp AT            &kp HASH           &kp DOLLAR  &kp PERCENT                      &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp DOUBLE_QUOTES  &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans      &trans       &trans      &trans  &trans     &kp UNDER      &kp PLUS   &kp PIPE              &kp TILDE
&kp SINGLE_QUOTE   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans      &trans       &trans      &trans  &trans     &kp MINUS      &kp EQUAL  &kp BACKSLASH         &kp GRAVE
&trans             &trans            &trans             &trans      &trans       &trans      &trans  &trans                                                     &trans
            >;
        };

        Bluetooth_etc {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        numbers_included {
            bindings = <
&kp N1            &kp N2  &kp N3  &kp N4  &kp N5                                      &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&kp Q             &kp W   &kp E   &kp R   &kp T   &trans      &trans                  &kp Y   &kp U   &kp I   &kp O   &kp P
&mt LEFT_SHIFT A  &kp S   &kp D   &kp F   &kp G   &trans      &lt_to_layer_0 0 ENTER  &kp H   &kp J   &kp K   &kp L   &mt RIGHT_SHIFT SEMICOLON
&trans            &trans  &trans  &trans  &trans  &trans      &trans                  &trans                          &lt 0 MINUS
            >;
        };

        SHIFT_CMD_NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp LS(LG(N7))        &kp LS(LG(N8))        &kp LS(LG(N9))        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LS(LG(NUMBER_4))  &kp LG(LS(N5))        &kp LS(LG(NUMBER_6))  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LS(LG(NUMBER_1))  &kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_3))  &kp LS(LG(N0))
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                                    &trans
            >;
        };
    };
};
